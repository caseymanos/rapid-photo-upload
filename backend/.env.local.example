# RapidPhotoUpload Backend - Local Development Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/photoupload
DATABASE_USERNAME=dbadmin
DATABASE_PASSWORD=password

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 Bucket Configuration
# Choose an existing bucket from your AWS account or create a new one
# Available buckets in your account (as of check):
# - backfill-queue-storage
# - be-app-payload-storage-dev-405894866050-us-east-1
# Recommendation: Create a new bucket specifically for this app: rapid-photo-upload-dev
S3_BUCKET_NAME=rapid-photo-upload-dev

# EventBridge Configuration (optional, defaults to 'default')
EVENTBRIDGE_BUS_NAME=default

# JWT Secret (IMPORTANT: Use a strong secret in production)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-this-to-something-secure

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
