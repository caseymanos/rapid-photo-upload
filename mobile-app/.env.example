# RapidPhotoUpload Mobile App Environment Configuration
# Copy this file to .env and update with your backend URL
# Note: Mobile app uses app.json extra.apiUrl for configuration

# Backend API Base URL (configured in app.json)
API_BASE_URL=http://your-backend-url.com

# WebSocket URL for real-time updates (configured in app.json)
WS_URL=ws://your-backend-url.com/ws

# Development configurations:
# For iOS simulator, use: http://localhost:8080/api/v1
# For Android emulator, use: http://10.0.2.2:8080/api/v1
# For physical device on same network, use: http://<your-computer-ip>:8080/api/v1

# Production (AWS ECS Fargate):
# API_BASE_URL=http://rapid-photo-upload-dev-alb-1693661982.us-east-1.elb.amazonaws.com
# WS_URL=ws://rapid-photo-upload-dev-alb-1693661982.us-east-1.elb.amazonaws.com/ws
