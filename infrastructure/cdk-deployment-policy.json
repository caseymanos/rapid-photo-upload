{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CDKCore",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*",
        "ssm:GetParameter",
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAM",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:TagRole",
        "iam:TagPolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::971422717446:role/cdk-*",
        "arn:aws:iam::971422717446:role/RapidPhotoUpload*",
        "arn:aws:iam::971422717446:policy/RapidPhotoUpload*"
      ]
    },
    {
      "Sid": "Network",
      "Effect": "Allow",
      "Action": [
        "ec2:*Vpc*",
        "ec2:*Subnet*",
        "ec2:*InternetGateway*",
        "ec2:*NatGateway*",
        "ec2:*Address*",
        "ec2:*RouteTable*",
        "ec2:*Route",
        "ec2:*SecurityGroup*",
        "ec2:*Tags",
        "ec2:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Database",
      "Effect": "Allow",
      "Action": [
        "rds:*DBInstance*",
        "rds:*DBSubnetGroup*",
        "rds:*DBParameterGroup*",
        "rds:*Tags*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Storage",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:*Bucket*",
        "s3:*Object*"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-*",
        "arn:aws:s3:::cdk-*/*",
        "arn:aws:s3:::rapid-photo-upload-*",
        "arn:aws:s3:::rapid-photo-upload-*/*"
      ]
    },
    {
      "Sid": "Compute",
      "Effect": "Allow",
      "Action": [
        "ecs:*",
        "ecr:*",
        "elasticloadbalancing:*",
        "application-autoscaling:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Events",
      "Effect": "Allow",
      "Action": [
        "events:*EventBus*",
        "events:*Rule*",
        "events:*Targets*",
        "events:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Monitoring",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:*",
        "logs:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Secrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SNS",
      "Effect": "Allow",
      "Action": [
        "sns:*"
      ],
      "Resource": "*"
    }
  ]
}
